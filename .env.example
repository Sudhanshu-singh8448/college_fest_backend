# ──────────────────────────────────────────────────
# TechGram Backend — Environment Variables
# ──────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://techgram_user:techgram_password@localhost:5432/techgram_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_to_a_random_string_64_chars
JWT_REFRESH_SECRET=change_me_to_another_random_string_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 Storage
R2_BUCKET=techgram-uploads
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://cdn.techgram.in

# Email (Resend)
RESEND_API_KEY=
