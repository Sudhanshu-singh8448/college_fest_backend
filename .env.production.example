# ──────────────────────────────────────────────────
# TechGram Backend — Production Environment
# Copy this to .env.production and fill in real values
# ──────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://sponsiwise.app,https://www.sponsiwise.app

# Database (managed by Docker Compose — don't change host/port)
DB_USER=techgram_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=techgram_db
DATABASE_URL=postgresql://techgram_user:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/techgram_db

# Redis (managed by Docker Compose — don't change host/port)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — GENERATE YOUR OWN SECRETS! (use: openssl rand -hex 64)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3/R2 Storage — fill in your actual AWS S3 or Cloudflare R2 credentials
R2_BUCKET=techgram-uploads
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
